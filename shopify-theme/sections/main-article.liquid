<header class="phead" data-section-id="{{ section.id }}">
  <div class="wrap">
    <nav class="crumbs mono" aria-label="{{ 'general.breadcrumb' | t }}">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span>/</span>
      <a href="{{ blog.url }}">{{ blog.title }}</a>
    </nav>
    <h1>{{ article.title }}</h1>
    <p class="mono">{{ article.published_at | date: '%d %b %Y' }}{% if article.author != blank %} · {{ article.author }}{% endif %}</p>
  </div>
</header>
<section class="sec">
  <div class="wrap">
    <div class="rte" style="max-width:65ch">{{ article.content }}</div>
  </div>
</section>

{% schema %}
{ "name": "Article", "tag": "section", "settings": [] }
{% endschema %}
