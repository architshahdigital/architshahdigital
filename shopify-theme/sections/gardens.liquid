<section class="sec origin" id="origin" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="sec__head reveal">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="plates">
      {%- for block in section.blocks -%}
        <article class="plate" {{ block.shopify_attributes }}>
          <span class="plate__n mono">{{ forloop.index | prepend: '0' | slice: -2, 2 }} · {{ block.settings.region }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gardens",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four gardens. Nothing in between." },
    { "type": "textarea", "id": "text", "label": "Text",
      "default": "Most tea passes through six hands before it reaches a shelf. Ours passes through two — the family that grows it, and us." }
  ],
  "blocks": [
    {
      "type": "garden",
      "name": "Garden",
      "settings": [
        { "type": "text", "id": "region", "label": "Region", "default": "Anhui, CN" },
        { "type": "text", "id": "title", "label": "Name", "default": "Huangshan" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Granite slopes at 1,240 m. Cloud cover slows the leaf and sweetens it." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Gardens",
      "blocks": [
        { "type": "garden", "settings": { "region": "Anhui, CN", "title": "Huangshan", "text": "Granite slopes at 1,240 m. Cloud cover slows the leaf and sweetens it." } },
        { "type": "garden", "settings": { "region": "Alishan, TW", "title": "Chiayi", "text": "High mountain oolong, rolled by hand into pearls that open over four steeps." } },
        { "type": "garden", "settings": { "region": "Yunnan, CN", "title": "Menghai", "text": "Old growth trees, some past two hundred years. Pressed and aged in Kunming." } },
        { "type": "garden", "settings": { "region": "Fujian, CN", "title": "Fuding", "text": "Silver needle picked over eleven days in March. Sun withered, never fired." } }
      ]
    }
  ]
}
{% endschema %}
