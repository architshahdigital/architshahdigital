{%- assign coll = section.settings.collection -%}
<section class="sec" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="sec__head reveal">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <div class="grid-teas">
      {%- if coll != blank and coll.products_count > 0 -%}
        {%- for product in coll.products limit: section.settings.count -%}
          {% render 'product-card', card_product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="tea reveal">
            <div class="tea__in">
              <span class="tea__shot" style="--s1:#A9C48C;--s2:#4A7C5D"></span>
              <div class="tea__top"><h3>{{ 'onboarding.product_title' | t }}</h3></div>
              <p class="tea__desc">{{ 'onboarding.product_text' | t }}</p>
              <div class="tea__buy"><span class="tea__price">{{ 1999 | money }}</span></div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.cta_text != blank -%}
      <div class="cta-row" style="justify-content:center;margin-top:2.6rem">
        <a class="btn3 btn3--ghost" href="{{ coll.url | default: routes.all_products_collection_url }}">{{ section.settings.cta_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured lots",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This season's lots" },
    { "type": "textarea", "id": "text", "label": "Text",
      "default": "Every pouch carries its garden, altitude and pick date. When a lot is gone it does not come back." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Products shown", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "View the full collection" }
  ],
  "presets": [{ "name": "Featured lots" }]
}
{% endschema %}
