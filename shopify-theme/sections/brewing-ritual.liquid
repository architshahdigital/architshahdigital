<section class="brew" id="brew" data-section-id="{{ section.id }}">
  <div class="brew__rail" id="brewRail">
    <div class="brew__stage">
      <div class="brew__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow mono">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.intro != blank -%}<p>{{ section.settings.intro }}</p>{%- endif -%}

        <div class="brew__phases">
          {%- for block in section.blocks -%}
            <div class="brew__phase" data-phase="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <b>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</b>
              <div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="brew__meter">
          <span class="mono" id="brewClock">0 s</span>
          <span class="brew__bar" id="brewBar"><i></i></span>
          <span class="mono" id="brewTemp">{{ section.settings.temperature }}</span>
        </div>
      </div>

      <div class="cup-stage">
        <div class="pour" id="pour"></div>
        <div class="steam" id="steam"><i></i><i></i><i></i></div>
        <div class="cup__saucer"></div>
        <div class="cup">
          <div class="cup__glass" id="glass">
            <div class="cup__liquid" id="liquid"></div>
            <div class="cup__shine"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brewing ritual",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "A scroll-driven sequence: leaf drops into the glass, water pours, the liquor deepens, steam rises. Needs at least four blocks to read correctly." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Five grams, eighty degrees, ninety seconds." },
    { "type": "textarea", "id": "intro", "label": "Intro",
      "default": "Scroll, and the leaf does the rest — dry into the glass, water off the boil, then the slow turn from clear to gold that tells you it is ready." },
    { "type": "text", "id": "temperature", "label": "Temperature readout", "default": "80 °C" }
  ],
  "blocks": [
    {
      "type": "phase",
      "name": "Phase",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Dry leaf" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Five grams of whole leaf, unbroken." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Brewing ritual",
      "blocks": [
        { "type": "phase", "settings": { "title": "Dry leaf", "text": "Five grams of whole leaf, unbroken. It should smell of chestnut before it ever meets water." } },
        { "type": "phase", "settings": { "title": "The pour", "text": "150 ml at 80 °C, poured down the side of the glass so the leaf is never scalded." } },
        { "type": "phase", "settings": { "title": "The steep", "text": "Ninety seconds. The leaf opens, sinks, and the water turns the colour of pale honey." } },
        { "type": "phase", "settings": { "title": "Ready", "text": "Chestnut, cut grass, a sweetness that arrives late. Four more steeps left in the leaf." } }
      ]
    }
  ]
}
{% endschema %}
