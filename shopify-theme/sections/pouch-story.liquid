<section class="sec pouch-sec" data-section-id="{{ section.id }}">
  <div class="wrap pouch-grid">
    {% render 'pouch-3d',
         id: 'pouch',
         brand: section.settings.label_brand,
         line1: section.settings.label_line,
         line2: section.settings.label_line2,
         kraft_light: section.settings.kraft_light,
         kraft_mid: section.settings.kraft_mid,
         kraft_dark: section.settings.kraft_dark,
         label_bg: section.settings.label_bg,
         label_ink: section.settings.label_ink,
         label_accent: section.settings.label_accent,
         scale: section.settings.pouch_scale,
         hint: section.settings.hint %}

    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow mono">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}

      <ul class="pouch-facts">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {% render 'icon', name: block.settings.icon %}
            <div><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.cta_text != blank -%}
        <div class="cta-row" style="margin-top:2rem">
          <a class="btn3 btn3--gold" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pouch story",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The pouch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Folded, stitched and stamped by hand." },
    { "type": "textarea", "id": "text", "label": "Text",
      "default": "No tins, no plastic tubs. Each pouch is folded from unbleached kraft, lined with a food-safe foil barrier, crimped along the top and stitched shut by hand in Kolkata." },
    { "type": "header", "content": "3D pouch label" },
    { "type": "text", "id": "label_brand", "label": "Wordmark on the pouch", "default": "Brew Your Sip" },
    { "type": "text", "id": "label_line", "label": "Line under the wordmark", "default": "Darjeeling First Flush" },
    { "type": "text", "id": "label_line2", "label": "Second line", "default": "50 g · Whole leaf" },
    { "type": "range", "id": "pouch_scale", "label": "Pouch size", "min": 70, "max": 140, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Pouch colours" },
    { "type": "color", "id": "kraft_light", "label": "Kraft highlight", "default": "#CFBA90" },
    { "type": "color", "id": "kraft_mid", "label": "Kraft mid", "default": "#AE9468" },
    { "type": "color", "id": "kraft_dark", "label": "Kraft shadow", "default": "#8B7249" },
    { "type": "color", "id": "label_bg", "label": "Label background", "default": "#12291F" },
    { "type": "color", "id": "label_ink", "label": "Label text", "default": "#E3D5BC" },
    { "type": "color", "id": "label_accent", "label": "Label accent", "default": "#C08A2E" },
    { "type": "text", "id": "hint", "label": "Hint text", "default": "Scroll to turn the pouch" },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "See a pouch up close" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "check", "label": "Check" },
            { "value": "clock", "label": "Clock" },
            { "value": "truck", "label": "Truck" }
          ], "default": "shield" },
        { "type": "text", "id": "title", "label": "Title", "default": "Foil lined, nitrogen flushed" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Light and oxygen are what kill green tea." }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Pouch story",
      "blocks": [
        { "type": "fact", "settings": { "icon": "shield", "title": "Foil lined, nitrogen flushed", "text": "Light and oxygen are what kill green tea. The barrier holds a lot at pick-day freshness for eighteen months unopened." } },
        { "type": "fact", "settings": { "icon": "leaf", "title": "Home compostable shell", "text": "Peel the foil liner and the kraft outer breaks down in a garden bin in about twelve weeks." } },
        { "type": "fact", "settings": { "icon": "check", "title": "Stamped with the lot", "text": "Garden, altitude and pick date are hand-stamped on every pouch." } }
      ]
    }
  ]
}
{% endschema %}
