<footer class="foot" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="foot__top">
      <div>
        <div class="foot__mark">{{ section.settings.brand | default: shop.name }}</div>
        {%- if section.settings.blurb != blank -%}
          <p class="foot__blurb">{{ section.settings.blurb }}</p>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="foot__legal mono">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.city != blank %} &middot; {{ section.settings.city }}{% endif %}</span>
      <span>
        {%- if section.settings.legal != blank -%}{{ section.settings.legal }}{%- endif -%}
        {%- if settings.contact_email != blank %} &middot; <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>{% endif -%}
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "brand", "label": "Wordmark", "default": "Verdant" },
    { "type": "textarea", "id": "blurb", "label": "Short description",
      "default": "Single origin, whole leaf tea in handmade pouches. Four gardens, four to six lots a year." },
    { "type": "text", "id": "city", "label": "City", "default": "Mumbai" },
    { "type": "text", "id": "legal", "label": "Legal line", "default": "Shipping across India" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Learn" } },
        { "type": "menu", "settings": { "heading": "Care" } }
      ]
    }
  ]
}
{% endschema %}
