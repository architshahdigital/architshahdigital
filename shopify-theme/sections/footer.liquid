<footer class="foot" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="foot__top">
      <div>
        <div class="foot__mark">{{ section.settings.brand | default: shop.name }}</div>
        {%- if section.settings.blurb != blank -%}
          <p class="foot__blurb">{{ section.settings.blurb }}</p>
        {%- endif -%}

        <div class="foot__addr">
          {%- if section.settings.store_name != blank -%}
            <span><strong style="color:var(--ink)">{{ section.settings.store_name }}</strong></span>
          {%- endif -%}
          {%- if section.settings.address != blank -%}
            <span>{{ section.settings.address | newline_to_br }}</span>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '-' }}">{{ section.settings.phone }}</a>
          {%- endif -%}
          {%- if section.settings.email != blank -%}
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          {%- endif -%}
          {%- if section.settings.hours != blank -%}
            <span class="mono">{{ section.settings.hours }}</span>
          {%- endif -%}
        </div>

        {%- comment -%} Social handles — each renders only when a URL is set {%- endcomment -%}
        <div class="foot__social">
          {%- for block in section.blocks -%}
            {%- if block.type == 'social' and block.settings.url != blank -%}
              <a href="{{ block.settings.url }}" target="_blank" rel="noopener"
                 aria-label="{{ block.settings.network }}" {{ block.shopify_attributes }}>
                {%- case block.settings.network -%}
                  {%- when 'Instagram' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none"/></svg>
                  {%- when 'Facebook' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h-2.5A4.5 4.5 0 0 0 8 7.5V11H5v4h3v7h4v-7h3l1-4h-4V7.5A.5.5 0 0 1 12.5 7H15z"/></svg>
                  {%- when 'WhatsApp' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-12.7 7.4L3 20.5l1.7-5.1A8.5 8.5 0 1 1 21 11.5z"/><path d="M8.8 8.4c.3-.1.7 0 .9.3l.8 1.2c.2.3.1.6-.1.8l-.5.5c.5 1 1.3 1.8 2.3 2.3l.5-.5c.2-.2.5-.3.8-.1l1.2.8c.3.2.4.6.3.9-.3.7-1 1.2-1.8 1.1-2.7-.3-4.9-2.5-5.2-5.2-.1-.8.4-1.5 1.1-1.8z"/></svg>
                  {%- when 'YouTube' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 5 3-5 3z"/></svg>
                  {%- when 'X' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18"/><path d="M12 3a15 15 0 0 0 0 18"/></svg>
                {%- endcase -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} Menu columns — point these at the same menus as the header {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' and block.settings.menu != blank -%}
          <div {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%}
        Policies come from Settings > Policies, so the links are always the real
        ones and can never go stale.
      {%- endcomment -%}
      {%- if section.settings.show_policies -%}
        <div>
          <h4>{{ section.settings.policies_heading }}</h4>
          <ul>
            {%- if shop.privacy_policy != blank -%}
              <li><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a></li>
            {%- endif -%}
            {%- if shop.refund_policy != blank -%}
              <li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></li>
            {%- endif -%}
            {%- if shop.shipping_policy != blank -%}
              <li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></li>
            {%- endif -%}
            {%- if shop.terms_of_service != blank -%}
              <li><a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a></li>
            {%- endif -%}
            {%- if shop.subscription_policy != blank -%}
              <li><a href="{{ shop.subscription_policy.url }}">{{ shop.subscription_policy.title }}</a></li>
            {%- endif -%}
            {%- if section.settings.extra_policy_menu != blank -%}
              {%- for link in section.settings.extra_policy_menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%}
      Map. Paste an embed URL from Google Maps (Share > Embed a map, then copy
      only the src="..." value) and it renders inline. With just a link set, it
      falls back to an address card with a directions button.
    {%- endcomment -%}
    {%- if section.settings.show_map -%}
      {%- if section.settings.map_embed != blank or section.settings.map_link != blank -%}
        <div class="foot__map{% if section.settings.map_embed == blank %} foot__map--noembed{% endif %}">
          {%- if section.settings.map_embed != blank -%}
            <iframe
              src="{{ section.settings.map_embed }}"
              title="{{ section.settings.map_title | default: 'Store location' | escape }}"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen></iframe>
          {%- endif -%}
          <div class="foot__map__bar">
            <p>
              <b>{{ section.settings.map_title | default: section.settings.store_name }}</b>
              {{ section.settings.map_note }}
            </p>
            {%- if section.settings.map_link != blank -%}
              <a class="btn3 btn3--ghost btn3--sm" href="{{ section.settings.map_link }}" target="_blank" rel="noopener">
                {{ section.settings.map_cta | default: 'Get directions' }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

    <div class="foot__legal mono">
      <span>
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand | default: shop.name }}
        {%- if section.settings.city != blank %} &middot; {{ section.settings.city }}{% endif -%}
      </span>
      <span>{{ section.settings.legal }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "brand", "label": "Wordmark", "default": "Brew Your Sip" },
    { "type": "textarea", "id": "blurb", "label": "Short description",
      "default": "Whole leaf tea in handmade pouches. The online vertical of Unique Tea Centre, New Market, Kolkata." },

    { "type": "header", "content": "Store details" },
    { "type": "text", "id": "store_name", "label": "Store name", "default": "Unique Tea Centre" },
    { "type": "textarea", "id": "address", "label": "Address",
      "default": "New Market, Lindsay Street\nKolkata 700087, West Bengal" },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@brewyoursip.com" },
    { "type": "text", "id": "hours", "label": "Opening hours", "default": "Mon-Sat · 11am-8pm" },
    { "type": "text", "id": "city", "label": "City", "default": "Kolkata" },
    { "type": "text", "id": "legal", "label": "Legal line", "default": "Shipping across India" },

    { "type": "header", "content": "Map" },
    { "type": "paragraph", "content": "In Google Maps: find the shop, click Share, then Embed a map, and copy only the src URL from the iframe. Paste it below. Leave it blank to show an address card with a directions button instead." },
    { "type": "checkbox", "id": "show_map", "label": "Show the map", "default": true },
    { "type": "text", "id": "map_embed", "label": "Google Maps embed URL" },
    { "type": "text", "id": "map_link", "label": "Directions link",
      "default": "https://maps.google.com/?q=Unique+Tea+Centre+New+Market+Kolkata" },
    { "type": "text", "id": "map_title", "label": "Map heading", "default": "Unique Tea Centre" },
    { "type": "text", "id": "map_note", "label": "Map note",
      "default": "Come and taste before you buy — New Market, Kolkata." },
    { "type": "text", "id": "map_cta", "label": "Button", "default": "Get directions" },

    { "type": "header", "content": "Policies" },
    { "type": "checkbox", "id": "show_policies", "label": "Show store policies", "default": true,
      "info": "Pulled live from Settings > Policies. Any policy you have not written is skipped." },
    { "type": "text", "id": "policies_heading", "label": "Heading", "default": "Policies" },
    { "type": "link_list", "id": "extra_policy_menu", "label": "Extra links",
      "info": "Optional, for pages Shopify has no policy field for, such as FAQs or contact." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu",
          "info": "Point this at the same menu as the header to mirror it." }
      ]
    },
    {
      "type": "social",
      "name": "Social handle",
      "settings": [
        { "type": "select", "id": "network", "label": "Network",
          "options": [
            { "value": "Instagram", "label": "Instagram" },
            { "value": "Facebook", "label": "Facebook" },
            { "value": "WhatsApp", "label": "WhatsApp" },
            { "value": "YouTube", "label": "YouTube" },
            { "value": "X", "label": "X" },
            { "value": "Other", "label": "Other" }
          ], "default": "Instagram" },
        { "type": "text", "id": "url", "label": "URL" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Learn" } },
        { "type": "social", "settings": { "network": "Instagram" } },
        { "type": "social", "settings": { "network": "Facebook" } },
        { "type": "social", "settings": { "network": "WhatsApp" } }
      ]
    }
  ]
}
{% endschema %}
