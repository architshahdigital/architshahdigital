<section class="nf" data-section-id="{{ section.id }}">
  <div class="nf__in">
    <p class="nf__code mono">{{ 'general.404.code' | t }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    <div class="cta-row" style="justify-content:center">
      <a class="btn3 btn3--gold" href="{{ routes.all_products_collection_url }}">{{ 'general.404.shop' | t }}</a>
      <a class="btn3 btn3--ghost" href="{{ routes.root_url }}">{{ 'general.404.home' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This leaf never made it into the pouch." },
    { "type": "textarea", "id": "text", "label": "Text",
      "default": "The page you asked for is not here. It may have been a lot that sold out — when a harvest is gone, its page goes with it." }
  ]
}
{% endschema %}
