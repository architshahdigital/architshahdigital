{%- if recommendations.performed and recommendations.products_count > 0 -%}
<section class="sec" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="sec__head reveal" style="grid-template-columns:minmax(0,1fr)">
      <h2 style="font-size:var(--t-2xl);letter-spacing:-.02em;max-width:18ch">{{ section.settings.heading }}</h2>
    </div>
    <div class="grid-teas">
      {%- for product in recommendations.products -%}
        {% render 'product-card', card_product: product %}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "You may also like",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "If you like this, try these next" }
  ]
}
{% endschema %}
